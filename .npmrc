# Hugeicons Pro is licensed. Only the scope→registry mapping lives here: pnpm 11.5.3+
# ignores credentials (and ${VAR} expansion) in a repository .npmrc, so the token is
# configured per machine with
#   pnpm config set //npm.collectui.pro/:_authToken <HUGEICONS_NPM_TOKEN>
# CI (workflow step), Vercel (apps/web/vercel.json installCommand) and EAS
# (eas-build-pre-install in apps/native) each read the HUGEICONS_NPM_TOKEN secret.
@hugeicons-pro:registry=https://npm.collectui.pro
