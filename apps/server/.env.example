BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# 支持多个 origin，用逗号分隔
# 例如: CORS_ORIGIN=https://folionote.xyz,https://www.folionote.xyz
# 本地开发环境 (localhost:*) 会自动允许
CORS_ORIGIN=

# ======================
# Database (Supabase in production\brew with pgsql server in development)
# ======================
# brew postgres server
# DATABASE_URL=postgresql://postgres:password@localhost:5432/folio_note
# supabase local server
DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=

# ======================
# Storage (S3 Protocol)
# ======================
# Supabase Storage S3 endpoint
# Local development: http://127.0.0.1:54321/storage/v1/s3
# Production: https://xxx.supabase.co/storage/v1/s3
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3

# S3 Access Key - from `supabase status` output
S3_ACCESS_KEY=

# S3 Secret Key - from `supabase status` output
S3_SECRET_KEY=

# S3 Region (default: local)
S3_REGION=local

# Optional: Public URL base for file access
# Default is derived from S3_ENDPOINT
# S3_PUBLIC_URL=http://127.0.0.1:54321/storage/v1/object/public

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# https://www.weatherapi.com
WEATHER_API_KEY=

# Alpha Vantage
STOCK_API_KEY=

TAVILY_API_KEY=

# 图片描述内部触发鉴权 token
IMAGE_CAPTION_INTERNAL_TOKEN=

# 可选：图片描述内部接口完整 URL
# IMAGE_CAPTION_INTERNAL_URL=http://127.0.0.1:3000/api/image/caption/internal

# 可选：是否允许服务端使用平台侧 AI 凭证为图片自动生成描述
# 默认关闭；仅影响内部异步触发与服务端补偿流程
IMAGE_CAPTION_ALLOW_ENV_FALLBACK=false

# 性能诊断（可选）。设置后 GET /internal/perf 返回各接口的 p50/p95/p99，
# 请求头 X-Perf-Token 需与之一致；不设置则该路由返回 404。至少 16 个字符。
PERF_TOKEN=
# 单次调用超过多少毫秒就单独打一条 warn 日志，默认 500
PERF_SLOW_MS=500
