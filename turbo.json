{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "NODE_ENV",
    "DEV",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "VITE_SERVER_URL",
    "VITE_WEB_URL",
    "VITE_RESEND_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "AI_KEY_ENCRYPTION_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "check-keys": {
      "cache": true,
      "inputs": ["src/resources/*.json", "scripts/check-keys.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "persistent": true
    },
    "db:push:prod": {
      "cache": false,
      "persistent": true
    },
    "db:studio:prod": {
      "cache": false,
      "persistent": true
    },
    "db:migrate:prod": {
      "cache": false,
      "persistent": true
    },
    "db:generate:prod": {
      "cache": false,
      "persistent": true
    },
    "db:start:supabase": {
      "cache": false
    },
    "db:stop:supabase": {
      "cache": false
    },
    "db:status:supabase": {
      "cache": false
    },
    "db:reset:supabase": {
      "cache": false
    },
    "db:start:docker": {
      "cache": false
    },
    "db:stop:docker": {
      "cache": false
    },
    "db:init:local": {
      "cache": false
    },
    "db:start:local": {
      "cache": false
    },
    "db:stop:local": {
      "cache": false
    }
  }
}
