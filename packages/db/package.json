{
  "name": "@folionote/db",
  "version": "0.2.28",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./__tests__/*": {
      "default": "./__tests__/*.ts"
    },
    "./__tests__/utils/*": {
      "default": "./__tests__/utils/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "DOTENV_CONFIG_PATH=../../apps/server/.env drizzle-kit push",
    "db:push:prod": "DOTENV_CONFIG_PATH=../../apps/server/.env.production drizzle-kit push",
    "db:generate": "DOTENV_CONFIG_PATH=../../apps/server/.env drizzle-kit generate",
    "db:seed:openjlpt": "DOTENV_CONFIG_PATH=../../apps/server/.env bun scripts/seed-openjlpt.ts",
    "db:import:moji": "node --import tsx scripts/import-moji.ts",
    "db:generate:prod": "DOTENV_CONFIG_PATH=../../apps/server/.env.production drizzle-kit generate",
    "db:studio": "DOTENV_CONFIG_PATH=../../apps/server/.env drizzle-kit studio",
    "db:studio:prod": "DOTENV_CONFIG_PATH=../../apps/server/.env.production drizzle-kit studio",
    "db:migrate": "DOTENV_CONFIG_PATH=../../apps/server/.env drizzle-kit migrate",
    "db:migrate:prod": "DOTENV_CONFIG_PATH=../../apps/server/.env.production drizzle-kit migrate",
    "db:start:supabase": "supabase start",
    "db:stop:supabase": "supabase stop",
    "db:status:supabase": "supabase status",
    "db:reset:supabase": "supabase db reset",
    "db:start:docker": "docker-compose up -d",
    "db:stop:docker": "docker-compose down",
    "db:init:local": "./scripts/init-local-db.sh",
    "db:start:local": "./scripts/start-local-db.sh",
    "db:stop:local": "./scripts/stop-local-db.sh"
  },
  "dependencies": {
    "@folionote/japanese": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@folionote/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "catalog:",
    "supabase": "^2.105.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
