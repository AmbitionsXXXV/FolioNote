{
  "name": "@folionote/editor-core",
  "version": "0.2.29",
  "description": "FolioNote headless editor core - platform-agnostic editor logic",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./commands": {
      "types": "./src/commands/index.ts",
      "default": "./src/commands/index.ts"
    },
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "default": "./src/extensions/index.ts"
    },
    "./suggestion": {
      "types": "./src/suggestion/index.ts",
      "default": "./src/suggestion/index.ts"
    },
    "./collab": {
      "types": "./src/collab/index.ts",
      "default": "./src/collab/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "catalog:",
    "@tiptap/extension-code-block": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-table-cell": "catalog:",
    "@tiptap/extension-table-header": "catalog:",
    "@tiptap/extension-table-row": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:"
  },
  "devDependencies": {
    "@folionote/config": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tiptap/core": "catalog:"
  }
}
